# Copy to .env.local and override as needed. All are optional — defaults
# point at the public Preview testnet (see src/lib/duskpay/config.ts).
#
# To develop against the local Docker environment instead (docker compose
# up -d at the repo root), uncomment the block below.

# VITE_NODE_URL=ws://localhost:9944
# VITE_INDEXER_HTTP_URL=http://localhost:8088/api/v4/graphql
# VITE_INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql
# VITE_PROOF_SERVER_URL=http://localhost:6300

# A previously deployed contract's address, so the UI doesn't try to
# deploy a fresh one on first use. Leave unset to deploy lazily instead.
# VITE_CONTRACT_ADDRESS=
